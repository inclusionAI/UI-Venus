# Copy to .env.run; runners source it after scripts/config.sh.
# Use the exact model ID returned by GET /v1/models.
# serve_vllm.sh can generate a matching .env.vllm.<name> automatically.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
MODEL=

# PerceptionBench judge: an independent OpenAI-compatible endpoint.
# The published run used a self-hosted Deepseekv4-flash-0731 deployment.
# Use your endpoint's actual served model ID. Judgments can vary between runs.
#JUDGE_API_KEY=
#JUDGE_BASE_URL=https://your-judge-endpoint/v1
#JUDGE_MODEL=Deepseekv4-flash-0731

# Optional overrides; defaults are defined in scripts/config.sh.
#SSPRO_WORKERS=8          # Threads per process
#SSPRO_NUM_PROCESSES=8    # Process count passed by run_all.sh
#HRBENCH_WORKERS=8        # Workers per split; 4K and 8K run concurrently
#REASONING_EFFORT=xhigh   # Passed through chat_template_kwargs
#THINKING_BUDGET=4096     # Shared reasoning-token budget, including PerceptionBench
#AGENTIC_THINKING_BUDGET=4096  # Optional PerceptionBench override; otherwise uses THINKING_BUDGET
#MAX_TOKENS=16384         # PerceptionBench's per-turn completion-token limit
#PB_NUM_SHARDS=8          # Full suite and standalone wrapper; explicit positional argument takes precedence
#PB_OUTPUT_SUFFIX=         # Optional filename suffix; producer and finalizer share it
#PB_SHARD_CONCURRENCY=4   # Total concurrency = shards * per-shard concurrency
#PB_SKIP_JUDGE=0          # Set 1 to defer judging
#CLEAN_INTERMEDIATES=1    # Set 0 to retain wrapper-managed checkpoints/progress/logs
#FINALIZE=1               # Set 0 to retain PB shards before manual --keep-shards finalization
#FORCE_RERUN=0            # Set 1 to bypass completed-stage guards
